   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">"Tamellat, Morocco - March 31st, 2012: Vehicles crossing flooded road, local men on the back of small truck deep in muddy water, people watching in the background; after heavy rains in the desert, North Africa."</rdf:li>
    </rdf:Alt>
   </dc:description>
